  "fixed_sql": [
    {
      "name": "nodes",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"nodes\" (\"id\" TEXT NOT NULL, \"parent_id\" TEXT NULL REFERENCES nodes (id), \"title\" TEXT NOT NULL, \"sort_index\" INTEGER NOT NULL, \"curriculum_key\" TEXT NULL, \"origin\" TEXT NOT NULL, \"created_at\" TEXT NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "items",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"items\" (\"id\" TEXT NOT NULL, \"node_id\" TEXT NOT NULL REFERENCES nodes (id), \"kind\" TEXT NOT NULL, \"title\" TEXT NOT NULL, \"body\" TEXT NULL, \"level\" TEXT NULL, \"sort_index\" INTEGER NOT NULL DEFAULT 0, \"suspended\" INTEGER NOT NULL DEFAULT 0 CHECK (\"suspended\" IN (0, 1)), \"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, \"phase\" TEXT NOT NULL, \"step\" INTEGER NULL, \"stability\" REAL NULL, \"difficulty\" REAL NULL, \"due\" TEXT NULL, \"last_review\" TEXT NULL, \"reps\" INTEGER NOT NULL DEFAULT 0, \"lapses\" INTEGER NOT NULL DEFAULT 0, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "review_logs",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"review_logs\" (\"id\" TEXT NOT NULL, \"item_id\" TEXT NOT NULL REFERENCES items (id) ON DELETE CASCADE, \"reviewed_at\" TEXT NOT NULL, \"rating\" TEXT NOT NULL, \"duration_ms\" INTEGER NULL, \"scheduler_id\" TEXT NOT NULL, \"state_before\" TEXT NOT NULL, \"state_after\" TEXT NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "settings",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"settings\" (\"key\" TEXT NOT NULL, \"value\" TEXT NOT NULL, PRIMARY KEY (\"key\"));"
        }
      ]
    },
    {
      "name": "documents",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"documents\" (\"id\" TEXT NOT NULL, \"title\" TEXT NOT NULL, \"role\" TEXT NOT NULL, \"page_count\" INTEGER NOT NULL, \"content_hash\" TEXT NOT NULL, \"imported_at\" TEXT NOT NULL, \"version\" INTEGER NOT NULL DEFAULT 1, \"fingerprints\" BLOB NOT NULL, \"new_pages\" TEXT NOT NULL DEFAULT '[]', \"last_page\" INTEGER NOT NULL DEFAULT 1, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "document_files",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"document_files\" (\"document_id\" TEXT NOT NULL REFERENCES documents (id) ON DELETE CASCADE, \"bytes\" BLOB NOT NULL, PRIMARY KEY (\"document_id\"));"
        }
      ]
    },
    {
      "name": "anchors",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"anchors\" (\"id\" TEXT NOT NULL, \"item_id\" TEXT NOT NULL REFERENCES items (id) ON DELETE CASCADE, \"document_id\" TEXT NOT NULL REFERENCES documents (id) ON DELETE CASCADE, \"role\" TEXT NOT NULL, \"page\" INTEGER NOT NULL, \"left\" REAL NULL, \"top\" REAL NULL, \"right\" REAL NULL, \"bottom\" REAL NULL, \"text_snippet\" TEXT NULL, \"snapshot\" BLOB NULL, \"needs_review\" INTEGER NOT NULL DEFAULT 0 CHECK (\"needs_review\" IN (0, 1)), \"created_at\" TEXT NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "notes",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"notes\" (\"id\" TEXT NOT NULL, \"body\" TEXT NOT NULL, \"document_id\" TEXT NULL REFERENCES documents (id) ON DELETE SET NULL, \"page\" INTEGER NULL, \"left\" REAL NULL, \"top\" REAL NULL, \"right\" REAL NULL, \"bottom\" REAL NULL, \"snapshot\" BLOB NULL, \"item_id\" TEXT NULL REFERENCES items (id) ON DELETE SET NULL, \"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
